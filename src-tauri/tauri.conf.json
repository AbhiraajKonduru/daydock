{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daydock",
  "version": "0.3.4",
  "identifier": "com.daydock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daydock",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#1b1b1a",
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "A simple productivity system for turning weekly goals into focused daily action.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MjI2M0NFQUZDNTk0RkIKUldUN2xNV3Z6bU1pbGNTeWlhZnFWdDdzY2lic2lqcEdKSS9jN0VvSmh0aHhHeFdsU2pMUk44SDMK",
      "endpoints": [
        "https://github.com/AbhiraajKonduru/daydock/releases/download/beta-channel/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
