# From `npx convex dev` in website/. Local Convex CLI also writes CONVEX_DEPLOYMENT.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Same random value in:
# 1) website/.env.local
# 2) Vercel project environment variables
# 3) Convex dashboard → Settings → Environment Variables
# Generate with: openssl rand -hex 32
CONVEX_INTERNAL_SECRET=

# Website-only. Set in website/.env.local and Vercel. Not needed in Convex.
# ADMIN_PASSWORD is the shared dashboard password for /impact-admin
# ADMIN_SESSION_SECRET and ANALYTICS_SALT should be long random strings.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ANALYTICS_SALT=
