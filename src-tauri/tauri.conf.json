{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daydock",
  "version": "0.2.0",
  "identifier": "com.daydock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daydock",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#1b1b1a",
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A simple productivity system for turning weekly goals into focused daily action.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
